theme("publication")
t = linspace(0, 1, 200)
subplot(3, 1, 1)
plot(t, sin(2*pi*3*t))
ylabel("Voltage (V)")
grid on
subplot(3, 1, 2)
plot(t, cos(2*pi*5*t))
ylabel("Current (mA)")
grid on
subplot(3, 1, 3)
plot(t, exp(-3*t))
xlabel("Time (s)")
ylabel("Envelope")
grid on
savefig("08_subplot_stack_publication.svg")
