{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Qu",
  "scopeName": "source.qu",
  "fileTypes": ["qu"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.cell.qu markup.heading.cell.qu",
          "match": "^\\s*#%%.*$"
        },
        {
          "name": "comment.line.number-sign.qu",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.raw.triple.qu",
          "begin": "\\br\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.other.raw.qu",
          "begin": "\\br\"",
          "end": "\""
        },
        {
          "name": "string.quoted.double.qu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.qu",
          "begin": "(?<![\\w)\\]}'])'",
          "end": "'",
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#string-interpolation" }
          ]
        }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.qu",
      "match": "\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
    },
    "string-interpolation": {
      "name": "meta.interpolation.qu",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.qu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.qu" }
      },
      "patterns": [
        { "include": "#expression" }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#numbers" },
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#keywords" },
        { "include": "#functions" },
        { "include": "#operators" },
        { "include": "#identifiers" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.qu",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.qu",
          "match": "(?<![\\w.])(\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[ij]?)(?:(Hz|kHz|MHz|GHz|ms|us|ns|mV|kV|mA|uA|mOhm|kOhm|MOhm|Ohm|ohm|kohm|Mohm|uF|nF|pF|mH|uH|mW|kW|dBm|dB|degC|degF|deg|rad|cycles|samples|MiB|GiB|KiB|km|cm|mm|um|nm|kWh|Ws|As|J|C|V|A|F|H|W|s|k|M|G|m|u|p|a)\\b)?",
          "captures": {
            "1": { "name": "constant.numeric.qu" },
            "2": { "name": "keyword.other.unit.qu" }
          }
        },
        {
          "name": "constant.numeric.qu",
          "match": "(?<![\\w.])\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?[ij]?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.qu",
          "match": "\\b(true|false|none)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.qu",
          "match": "\\b(bool|int64|int|uint64|uint|float64|float|double|complex128|complex|string|str|array|vector|matrix|tensor|record|list|figure|frame|logical|integer)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.qu",
          "match": "\\bend\\s+(parallel|select)\\b"
        },
        {
          "name": "keyword.control.qu",
          "match": "\\b(and|as|break|by|case|cases|catch|continue|do|each|else|elseif|elsewhere|end|for|from|if|in|loop|mod|not|on|or|otherwise|repeat|return|skip|step|then|to|try|until|use|using|while|with)\\b"
        },
        {
          "name": "keyword.control.qu",
          "match": "\\b(where)\\b(?!\\s*\\()"
        },
        {
          "name": "keyword.other.qu",
          "match": "^\\s*\\b(after)\\b(?!\\s*[=(])"
        },
        {
          "name": "keyword.other.qu",
          "match": "^\\s*\\b(parallel)\\b(?=\\s+for\\b)"
        },
        {
          "name": "keyword.other.qu",
          "match": "^\\s*\\b(select)\\b(?=\\s+case\\b)"
        },
        {
          "name": "keyword.other.qu",
          "match": "^\\s*\\b(type)\\b(?=\\s+implicit\\b|\\s+explicit\\b)"
        },
        {
          "name": "keyword.other.qu",
          "match": "\\b(assert|async|await|backend|base|class|collect|compose|const|constant|data|def|device|dimension|distributed|ease|elemental|enum|every|export|finetune|flag|frame|function|global|hold|implements|import|inherits|inline|interface|layer|let|local|method|mesh|model|module|namespace|new|node|optional|override|project|property|pure|render|reserve|release|restore|run|scene3d|schedule|simd|sketch|stencil|sub|train|tune|unit|unsafe|vectorize|view|watch|window)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.qu",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.qu",
          "match": "\\.\\*=|\\./=|:=|==|!=|<=|>=|\\+=|-=|\\*=|/=|\\.=|\\^=|=>|\\.\\^|\\*\\*|\\.\\*|\\./|\\.\\\\|\\|>|->|&&|\\|\\||\\?\\?|[=<>+\\-*/\\\\^!&|~@?]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.qu",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
