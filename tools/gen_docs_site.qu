# Render every documentation page into the website as styled HTML.
#
# The docs are written in Markdown because that is the right source
# format -- it diffs, and the example-checker can run the code blocks out
# of it. But a link to a `.md` file opens raw text in a browser, which is
# not a website. This renders the lot into `website/docs/`, in the site's
# own design, with a sidebar built from the book's own SUMMARY.
#
# Regenerated rather than hand-maintained, so the site and the docs
# cannot drift.
#
# Run:  qu run tools/gen_docs_site.qu

# Two optional working directories turn on the two extras. With
# `QU_DOC_EXTRACT` set, each ```qu block is written out as a runnable file
# with every earlier block of the same page in front of it (that is how a
# reader meets it: the tutorial that says "now plot it" defined `x` three
# paragraphs up). `tools/run_doc_outputs.sh` runs those and leaves a `.out`
# beside each; with `QU_DOC_OUTPUTS` pointing at the same directory, a
# second pass folds the printed output in under its own example.
#
# `tools/build_docs_site.sh` runs all three steps.
OUT     = "website/docs"
EXTRACT = getenv("QU_DOC_EXTRACT") ?? ""
RUNS    = getenv("QU_DOC_OUTPUTS") ?? ""
BT  = substr("`x", 0, 1)             # a backtick, unwritable in a string
QUOTE  = "\""
BSLASH = "\\"

DIGITS = "0123456789"
ALPHA  = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"

# Straight from `qu-lexer`'s KEYWORDS. Words the parser promotes only in
# statement position are deliberately absent: colouring `run` or `pool`
# everywhere would paint ordinary variables.
KEYS = ("and", "or", "not", "mod", "in", "as", "to", "step", "skip", "by",
        "if", "then", "else", "elseif", "end", "for", "while", "do", "repeat",
        "until", "return", "function", "sub", "class", "new", "true", "false",
        "none", "backend", "with", "import", "const", "constant", "try",
        "catch", "unsafe", "global")

