# strip_unbuilt_spec.qu — the specification, restricted to what exists.
#
# `docs/qu-language-spec.md` is a design document and says so in its own
# header: "Status: Specification first; engine later". Rendered on the site
# as a documentation page, that framing is three thousand lines above the
# reader, so §56 ("3D Modeling, Spatial Audio, and Real-Time Physics" — 2
# of its 33 names exist) reads exactly like §36 (DataFrames, all of which
# do). Ahmed's rule: absent means removed from the public docs.
#
# So this writes a second copy carrying only the chapters the engine
# actually implements. The full document stays in the working repo, because
# it is the design record and deleting it would lose the reasoning; the
# published copy stops claiming what is not there.
#
# The list below is not a guess. `tools/spec_coverage.qu` measures every
# chapter by pulling the names its code blocks call and asking the engine
# whether it answers to them; re-run it after any batch of work and move a
# chapter out of this list when it earns its way out.
#
#   qu run tools/strip_unbuilt_spec.qu

SRC = "docs/qu-language-spec.md"
OUT = "docs/qu-language-spec.built.md"

# Chapter number, coverage as measured, and the names that gave it away.
DROP = ("45", "46", "48", "49", "50", "51", "52", "53", "54", "55", "56", "59")

WHY = ("45. Intuitive Model Building — 35%: `resnet`, `vgg`, `bert`, `gpt`, `gan`, `vae`, `unet` and the rest of the model zoo do not exist.",
       "46. Design Wishes: What the Community Asks For — 33%, and wishes by its own title.",
       "48. Impedance Spectroscopy and Equivalent-Circuit Modeling — 15%: `read_eis`, `circuit`, `drt`, `validate_kk` are absent. The regularized Kramers-Kronig check that IS built is documented in the standard library, not here.",
       "49. Further Inspirations: Scheduling, Stencils, Distribution — 11%: `tile`, `vectorize`, `stencil`, `distributed`, `compose`.",
       "50. Operating System, Files, and Communication — 31%: `seek`, `tell`, `watch`, `udp`, `glob`, `mkdir`, `exists`.",
       "51. 3D Graphics, Meshes, and Scenes — 19%: `mesh`, `sphere`, `light`, `camera`, `isosurface`, `volume`, `streamlines`.",
       "52. Simulation and Physics — 29%: `solve_ode`, `laplacian`, `netlist`, `ac_sweep`, `transient`.",
       "53. Objects, Classes, and Structured Control — 30%: `new`, and the class syntax around it.",
       "54. Distributed Execution — 22%: `worker`, `cluster`, `discover`, `remote`.",
       "55. Reliability and Mission-Critical Monitoring — 17%: `watchdog`, `redundant`, `vote`, `escalate_if`.",
       "56. 3D Modeling, Spatial Audio, and Real-Time Physics — 6%: `csg`, `sphere`, `extrude`, `revolve`, `pbr`, `scene3d`, `spatialize`, `raycast`. Nothing in the chapter runs.",
       "59. Algorithm Testing, Sandboxes, Testbenches — 18%: `test`, `bench`, `sandbox`, `assert_close` are syntax the parser does not have.")

function chapter_number(heading)
    # "## 56. 3D Modeling..." -> "56"
    rest = substr(heading, 3, len(heading) - 3)
    num = ""
    for i in 0 to len(rest) - 1
        c = substr(rest, i, 1)
        if contains("0123456789", c)
            num = num + c
        else
            break
        end if
    end for
    return num
end function

function is_dropped(num)
    if len(num) == 0
        return false
    end if
    for d in DROP
        if d == num
            return true
        end if
    end for
    return false
end function

src = read_all_text(SRC)
h = fopen(OUT, "w")
write(h, "<!-- Generated by tools/strip_unbuilt_spec.qu from
     docs/qu-language-spec.md. Do not edit: edit the source and re-run
     bash tools/build_site.sh. -->

")

kept = 0
dropped = 0
skipping = false
inserted_note = false

for line in lines(src)
    t = trim(line)

    if starts_with(t, "## ")
        num = chapter_number(t)
        skipping = is_dropped(num)
        if skipping
            dropped = dropped + 1
        else
            kept = kept + 1
        end if
    end if

    if skipping
        continue
    end if

    write(h, line)
    write(h, "\n")

    # The header block ends at the first horizontal rule or the first
    # chapter; put the note where a reader meets it before any content.
    if not inserted_note and starts_with(t, "Status:")
        inserted_note = true
        write(h, "\n")
        write(h, "> **This edition carries only what the engine implements.**\n")
        write(h, "> The specification is written ahead of the engine on purpose, and\n")
        write(h, "> the chapters below described work that has not been built. They\n")
        write(h, "> are removed here rather than left to read as though they had:\n")
        write(h, ">\n")
        for w in WHY
            write(h, "> - " + w + "\n")
        end for
        write(h, ">\n")
        write(h, "> Coverage is measured, not asserted -- `tools/spec_coverage.qu`\n")
        write(h, "> pulls the names each chapter's examples call and asks the engine\n")
        write(h, "> whether it answers to them. A section reference to one of the\n")
        write(h, "> removed chapters will not resolve in this edition.\n")
        write(h, "\n")
    end if
end for

close(h)

print("kept {kept} chapters, removed {dropped}")
print("wrote " + OUT)
