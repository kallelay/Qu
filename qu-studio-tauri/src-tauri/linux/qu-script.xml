<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definition of the Qu script type. Installed to
     /usr/share/mime/packages/qu-script.xml by the .deb and .rpm
     (bundle.deb.files / bundle.rpm.files in tauri.conf.json); the package
     manager's triggers run update-mime-database. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-qu-script">
    <comment>Qu script</comment>
    <comment xml:lang="de">Qu-Skript</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.qu"/>
  </mime-type>
</mime-info>
