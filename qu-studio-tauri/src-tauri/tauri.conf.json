{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "bash ../tools/refuse_if_parked.sh && npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Qu Studio",
    "version": "0.4.11"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "sidecar": true,
        "scope": [
          {
            "name": "binaries/qu",
            "cmd": "binaries/qu",
            "sidecar": true,
            "args": true
          }
        ]
      },
      "fs": {
        "all": true,
        "scope": ["**"]
      },
      "path": {
        "all": true
      },
      "dialog": {
        "all": true,
        "ask": true,
        "confirm": true,
        "message": true,
        "open": true,
        "save": true
      },
      "process": {
        "all": true,
        "exit": true
      },
      "window": {
        "all": false,
        "create": true,
        "close": true,
        "setTitle": true,
        "setFocus": true,
        "center": true,
        "show": true,
        "hide": true
      }
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "Copyright (c) Qu project contributors. Apache-2.0.",
      "deb": {
        "depends": [],
        "desktopTemplate": "linux/qu-studio.desktop",
        "files": {
          "/usr/share/mime/packages/qu-script.xml": "linux/qu-script.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/qu-studio.desktop",
        "files": {
          "/usr/share/mime/packages/qu-script.xml": "linux/qu-script.xml"
        }
      },
      "externalBin": ["binaries/qu"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.qu.studio",
      "longDescription": "Qu Studio - Modern IDE for the Qu scientific scripting language",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": ["../../catalog/**/*", "../../editors/**/*"],
      "shortDescription": "Qu Studio IDE",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "",
        "nsis": {
          "template": "installer.nsi"
        }
      }
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://asset.localhost asset:; font-src 'self' data:; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; base-uri 'self'; form-action 'none'"
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "Qu Studio",
        "width": 1400,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ]
  }
}
