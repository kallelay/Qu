function fact(k)
    if k <= 1 then
        return 1
    end if
    return k * fact(k - 1)
end function
acc = 0
for i = 1 to 20000
    t = table(a=[1, 2, 3], b=[4, 5, 6])
    m = [1, 2, 3, 4] as matrix(2, 2)
    m2 = m * m
    r = {x = i, y = "s"}
    l = (i, "a", [1, 2])
    acc = acc + fact(10) + sum(m2)
    s = ""
    for j = 1 to 20
        s = s + "ab"
    end for
end for
print(acc)
