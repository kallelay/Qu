# bench.qu -- MLP (20->64->32->4, He-init, ReLU, softmax+cross-entropy)
# trained via plain param()/grad()/stop_grad(), full-batch gradient
# descent -- the same manual per-layer autodiff loop pattern as the
# existing acceptance-test MLP/CNN/transformer training loops
# (engine/crates/qu-interp/tests/acceptance.rs), just at a real,
# multi-hundred-sample classification scale instead of a toy example.
#
# Same architecture, same initial weights (pasted below verbatim from
# make_dataset.py's numpy RandomState(42) He init -- Qu's own RNG and
# numpy's are different algorithms, so there is no "same seed" shortcut to
# bit-identical floats across languages; the actual values are generated
# once in Python and shared byte-for-byte with bench.py), same data
# (classification_{train,test}.csv, same make_dataset.py), same
# epochs/lr, same loss formula (-mean(sum(Y_onehot .* ln(softmax_rows
# (logits)), axis=1))) as bench.py, for an apples-to-apples timing +
# accuracy comparison.
#
# Run: qu run benchmarks/mlp/bench.qu
# (or: cargo run --manifest-path engine/Cargo.toml -p qu-cli --release -- run benchmarks/mlp/bench.qu)

backend auto

DATA = "benchmarks/mlp/"
EPOCHS = 300
LR = 0.05
N_CLASSES = 4

# --- load data (same convention as benchmarks/shallow_ml/bench.qu) --------
df = read_csv(DATA + "classification_train.csv")
dfte = read_csv(DATA + "classification_test.csv")
n = nrow(df)
nte = nrow(dfte)
Xtr = hstack(reshape(df.f0, n, 1), reshape(df.f1, n, 1), reshape(df.f2, n, 1), reshape(df.f3, n, 1), reshape(df.f4, n, 1), reshape(df.f5, n, 1), reshape(df.f6, n, 1), reshape(df.f7, n, 1), reshape(df.f8, n, 1), reshape(df.f9, n, 1), reshape(df.f10, n, 1), reshape(df.f11, n, 1), reshape(df.f12, n, 1), reshape(df.f13, n, 1), reshape(df.f14, n, 1), reshape(df.f15, n, 1), reshape(df.f16, n, 1), reshape(df.f17, n, 1), reshape(df.f18, n, 1), reshape(df.f19, n, 1))
Xte = hstack(reshape(dfte.f0, nte, 1), reshape(dfte.f1, nte, 1), reshape(dfte.f2, nte, 1), reshape(dfte.f3, nte, 1), reshape(dfte.f4, nte, 1), reshape(dfte.f5, nte, 1), reshape(dfte.f6, nte, 1), reshape(dfte.f7, nte, 1), reshape(dfte.f8, nte, 1), reshape(dfte.f9, nte, 1), reshape(dfte.f10, nte, 1), reshape(dfte.f11, nte, 1), reshape(dfte.f12, nte, 1), reshape(dfte.f13, nte, 1), reshape(dfte.f14, nte, 1), reshape(dfte.f15, nte, 1), reshape(dfte.f16, nte, 1), reshape(dfte.f17, nte, 1), reshape(dfte.f18, nte, 1), reshape(dfte.f19, nte, 1))
ytr = df.y
yte = dfte.y
print("train {n}x{cols(Xtr)}, test {nte}x{cols(Xte)}")

# one-hot encode the integer labels (0..N_CLASSES-1)
function one_hot(y, rows, k)
    m = zeros(rows, k)
    for i = 0 to rows - 1
        m[i, y[i]] = 1
    end for
    return m
end function

Ytr = one_hot(ytr, n, N_CLASSES)
Yte = one_hot(yte, nte, N_CLASSES)

