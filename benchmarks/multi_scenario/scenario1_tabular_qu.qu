# scenario1_tabular_qu.qu -- Scenario 1 (tabular/MLP), Qu side.
#
# Reuses ../mlp/'s already-committed dataset (classification_{train,test}.csv,
# sklearn make_classification, 20 features / 4 classes, 2400 train / 600 test
# rows -- see ../mlp/README.md) and the same architecture/epochs/lr as
# ../mlp/ and ../sequential_api/ for continuity: 20 -> 64 -> 32 -> 4, ReLU
# hidden layers, softmax+cross-entropy output, full-batch gradient descent,
# 300 epochs, lr=0.05, plain SGD (no momentum/Adam).
#
# Uses the high-level Sequential-API zoo constructor (`mlp_classifier` +
# `net.fit(...)`, same as ../sequential_api/bench.qu) rather than a manual
# param()/grad() loop -- that manual-vs-native-loop question is already
# answered by ../mlp/ vs ../sequential_api/; this benchmark's job is the
# 3-way Qu/PyTorch/Keras comparison, not re-litigating that.
#
# Run: qu run benchmarks/multi_scenario/scenario1_tabular_qu.qu
# (or: cargo run --manifest-path engine/Cargo.toml -p qu-cli --release -- run benchmarks/multi_scenario/scenario1_tabular_qu.qu)
# (or the prebuilt release binary: engine/target/release/qu.exe run benchmarks/multi_scenario/scenario1_tabular_qu.qu)

backend auto

DATA = "benchmarks/mlp/"
EPOCHS = 300
LR = 0.05
N_CLASSES = 4

df = read_csv(DATA + "classification_train.csv")
dfte = read_csv(DATA + "classification_test.csv")
n = nrow(df)
nte = nrow(dfte)
Xtr = hstack(reshape(df.f0, n, 1), reshape(df.f1, n, 1), reshape(df.f2, n, 1), reshape(df.f3, n, 1), reshape(df.f4, n, 1), reshape(df.f5, n, 1), reshape(df.f6, n, 1), reshape(df.f7, n, 1), reshape(df.f8, n, 1), reshape(df.f9, n, 1), reshape(df.f10, n, 1), reshape(df.f11, n, 1), reshape(df.f12, n, 1), reshape(df.f13, n, 1), reshape(df.f14, n, 1), reshape(df.f15, n, 1), reshape(df.f16, n, 1), reshape(df.f17, n, 1), reshape(df.f18, n, 1), reshape(df.f19, n, 1))
Xte = hstack(reshape(dfte.f0, nte, 1), reshape(dfte.f1, nte, 1), reshape(dfte.f2, nte, 1), reshape(dfte.f3, nte, 1), reshape(dfte.f4, nte, 1), reshape(dfte.f5, nte, 1), reshape(dfte.f6, nte, 1), reshape(dfte.f7, nte, 1), reshape(dfte.f8, nte, 1), reshape(dfte.f9, nte, 1), reshape(dfte.f10, nte, 1), reshape(dfte.f11, nte, 1), reshape(dfte.f12, nte, 1), reshape(dfte.f13, nte, 1), reshape(dfte.f14, nte, 1), reshape(dfte.f15, nte, 1), reshape(dfte.f16, nte, 1), reshape(dfte.f17, nte, 1), reshape(dfte.f18, nte, 1), reshape(dfte.f19, nte, 1))
ytr = df.y
yte = dfte.y
print("train {n}x{cols(Xtr)}, test {nte}x{cols(Xte)}")

function one_hot(y, rows, k)
    m = zeros(rows, k)
    for i = 0 to rows - 1
        m[i, y[i]] = 1
    end for
    return m
end function

Ytr = one_hot(ytr, n, N_CLASSES)
Yte = one_hot(yte, nte, N_CLASSES)

net = mlp_classifier(20, [64, 32], N_CLASSES, seed=42)

tic()
trained = net.fit(Xtr, Ytr, epochs=EPOCHS, lr=LR, loss="cross_entropy")
train_time = toc()

losses = trained.loss_history
print("first_loss={losses[0]:.6f}  last_loss={losses[EPOCHS - 1]:.6f}")
print("train_time_s={train_time:.4f}  per_epoch_ms={1000 * train_time / EPOCHS:.4f}")

function accuracy(net, X, Y, rows)
    logits = net.predict(X)
    correct = 0
    for i = 0 to rows - 1
        row = logits[i, :]
        yrow = Y[i, :]
        if argmax(row) == argmax(yrow) then
            correct = correct + 1
        end if
    end for
    return correct / rows
end function

train_acc = accuracy(trained, Xtr, Ytr, n)
test_acc = accuracy(trained, Xte, Yte, nte)
print("train_accuracy={train_acc:.4f}  test_accuracy={test_acc:.4f}")
