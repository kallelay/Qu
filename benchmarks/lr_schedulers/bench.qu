# bench.qu -- lr_adaptive/lr_plateau learning-rate CONTROLLERS vs PyTorch
# equivalents (bench.py). Reuses ../mlp/'s already-committed
# classification_{train,test}.csv directly (same 3000-row/20-feature/
# 4-class make_classification split ../mlp/bench.py and
# ../sequential_api/bench.qu both read) -- not a new dataset in disguise --
# and the same `20 -> 64 -> 32 -> 4` architecture/seed=42 Sequential-API
# construction `../sequential_api/bench.qu` uses (`mlp_classifier(...)` +
# `net.fit(...)`), since `lr_adaptive`/`lr_plateau` are only reachable
# through `optimizer=` on `.fit(...)`/`compile(...)` -- there is no manual-
# loop equivalent to reuse from `../mlp/`.
#
# Four runs, matching the dated IMPL.md entry for these two controllers
# (see `BACKLOG.md`/`IMPL.md`, "lr_adaptive/lr_plateau learning-rate
# controllers, 2026-08-26") so this script's own numbers can be checked
# against that entry's:
#   1. fixed-lr SGD (lr=0.05)                                    -- baseline
#   2. lr_adaptive(lr=0.05, increase_factor=1.05, decrease_factor=0.5)
#   3. lr_plateau(lr=0.05, patience=10, factor=0.5, base="sgd")
#   4. lr_adaptive(lr=5.0, increase_factor=1.05, decrease_factor=0.5)  -- a
#      deliberately-oversized starting lr (100x the sane value), to show
#      the reject-and-retry mechanism actually earning its keep instead of
#      diverging the way fixed-lr SGD at lr=5.0 would.
#
# A fresh `mlp_classifier(20, [64, 32], N_CLASSES, seed=42)` is built for
# EACH run so all four start from the exact same initial weights (Qu's own
# He/Xavier initializer, not bit-identical to PyTorch's -- see
# `../sequential_api/bench.qu`'s own doc comment for why that rigor isn't
# attempted there either); this benchmark is about the controllers'
# trajectories/final numbers, not re-proving bit-identical-floats gradient
# correctness from scratch again.
#
# Run: qu run benchmarks/lr_schedulers/bench.qu
# (or: cargo run --manifest-path engine/Cargo.toml -p qu-cli --release -- run benchmarks/lr_schedulers/bench.qu)

backend auto

DATA = "benchmarks/mlp/"
EPOCHS = 300
N_CLASSES = 4

# --- load data (same CSVs ../mlp/bench.qu and ../sequential_api/bench.qu
# both read) ------------------------------------------------------------
df = read_csv(DATA + "classification_train.csv")
dfte = read_csv(DATA + "classification_test.csv")
n = nrow(df)
nte = nrow(dfte)
Xtr = hstack(reshape(df.f0, n, 1), reshape(df.f1, n, 1), reshape(df.f2, n, 1), reshape(df.f3, n, 1), reshape(df.f4, n, 1), reshape(df.f5, n, 1), reshape(df.f6, n, 1), reshape(df.f7, n, 1), reshape(df.f8, n, 1), reshape(df.f9, n, 1), reshape(df.f10, n, 1), reshape(df.f11, n, 1), reshape(df.f12, n, 1), reshape(df.f13, n, 1), reshape(df.f14, n, 1), reshape(df.f15, n, 1), reshape(df.f16, n, 1), reshape(df.f17, n, 1), reshape(df.f18, n, 1), reshape(df.f19, n, 1))
Xte = hstack(reshape(dfte.f0, nte, 1), reshape(dfte.f1, nte, 1), reshape(dfte.f2, nte, 1), reshape(dfte.f3, nte, 1), reshape(dfte.f4, nte, 1), reshape(dfte.f5, nte, 1), reshape(dfte.f6, nte, 1), reshape(dfte.f7, nte, 1), reshape(dfte.f8, nte, 1), reshape(dfte.f9, nte, 1), reshape(dfte.f10, nte, 1), reshape(dfte.f11, nte, 1), reshape(dfte.f12, nte, 1), reshape(dfte.f13, nte, 1), reshape(dfte.f14, nte, 1), reshape(dfte.f15, nte, 1), reshape(dfte.f16, nte, 1), reshape(dfte.f17, nte, 1), reshape(dfte.f18, nte, 1), reshape(dfte.f19, nte, 1))
ytr = df.y
yte = dfte.y
print("train {n}x{cols(Xtr)}, test {nte}x{cols(Xte)}")

function one_hot(y, rows, k)
    m = zeros(rows, k)
    for i = 0 to rows - 1
        m[i, y[i]] = 1
    end for
    return m
end function

Ytr = one_hot(ytr, n, N_CLASSES)
Yte = one_hot(yte, nte, N_CLASSES)

function accuracy(net, X, Y, rows)
    logits = net.predict(X)
    correct = 0
    for i = 0 to rows - 1
        row = logits[i, :]
        yrow = Y[i, :]
        if argmax(row) == argmax(yrow) then
            correct = correct + 1
        end if
    end for
    return correct / rows
end function

function report(name, trained)
    losses = trained.loss_history
    lrs = trained.lr_history
    print("== {name} ==")
    print("  loss: first={losses[0]:.6f} ep50={losses[50]:.6f} ep150={losses[150]:.6f} last={losses[EPOCHS - 1]:.6f}")
    print("  lr:   ep0={lrs[0]:.6f} ep50={lrs[50]:.6f} ep100={lrs[100]:.6f} ep150={lrs[150]:.6f} ep200={lrs[200]:.6f} ep299={lrs[EPOCHS - 1]:.6f}")
    train_acc = accuracy(trained, Xtr, Ytr, n)
    test_acc = accuracy(trained, Xte, Yte, nte)
    print("  train_accuracy={train_acc:.4f}  test_accuracy={test_acc:.4f}")
end function

# --- 1. fixed-lr SGD (lr=0.05) baseline -------------------------------------
tic()
net1 = mlp_classifier(20, [64, 32], N_CLASSES, seed=42)
trained1 = net1.fit(Xtr, Ytr, epochs=EPOCHS, loss="cross_entropy", optimizer=sgd(lr=0.05))
t1 = toc()
report("fixed-lr SGD (lr=0.05)", trained1)
print("  time_s={t1:.4f}")

# --- 2. lr_adaptive(lr0=0.05, inc=1.05, dec=0.5) ----------------------------
tic()
net2 = mlp_classifier(20, [64, 32], N_CLASSES, seed=42)
trained2 = net2.fit(Xtr, Ytr, epochs=EPOCHS, loss="cross_entropy", optimizer=lr_adaptive(lr=0.05, increase_factor=1.05, decrease_factor=0.5))
t2 = toc()
report("lr_adaptive (lr0=0.05, inc=1.05, dec=0.5)", trained2)
print("  time_s={t2:.4f}")

# --- 3. lr_plateau(lr0=0.05, patience=10, factor=0.5) -----------------------
tic()
net3 = mlp_classifier(20, [64, 32], N_CLASSES, seed=42)
trained3 = net3.fit(Xtr, Ytr, epochs=EPOCHS, loss="cross_entropy", optimizer=lr_plateau(lr=0.05, patience=10, factor=0.5, base="sgd"))
t3 = toc()
report("lr_plateau (lr0=0.05, patience=10, factor=0.5)", trained3)
print("  time_s={t3:.4f}")

# --- 4. lr_adaptive, deliberately-oversized lr0=5.0 (100x sane) -------------
tic()
net4 = mlp_classifier(20, [64, 32], N_CLASSES, seed=42)
trained4 = net4.fit(Xtr, Ytr, epochs=EPOCHS, loss="cross_entropy", optimizer=lr_adaptive(lr=5.0, increase_factor=1.05, decrease_factor=0.5))
t4 = toc()
report("lr_adaptive (deliberately large lr0=5.0)", trained4)
print("  time_s={t4:.4f}")
