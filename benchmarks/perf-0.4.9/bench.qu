# perf-0.4.9 benchmark set (Qu side). One process = one replicate; every
# workload prints "BENCH <name> <seconds>" (wall clock, data built outside
# the clock). bench.py has the same names. Driver: run.ps1; aggregation: agg.qu.

function rep(name, dt)
    print("BENCH {name} {dt}")
end function

function add1(a)
    return a + 1
end function

function ucall_loop(n)
    s = 0.0
    for i = 1 to n
        s = add1(s)
    end for
    return s
end function

function scalar_loop(n)
    s = 0.0
    for i = 1 to n
        s = s + i * 0.5
    end for
    return s
end function

function fsys(t, y)
    return [y[1], -y[0]]
end function

function integrand(x)
    return exp(-x * x) * cos(3 * x)
end function

seed(1)
# ---- baseline (do-nothing) ----
tic()
rep("baseline_empty", toc())

# ---- dense linear algebra ----
for n in (500, 1000)
    A = randn(n, n)
    B = randn(n, n)
    tic()
    C = A * B
    rep("matmul_{n}", toc())
end for
for n in (200, 500, 1000)
    A = randn(n, n)
    b = randn(n)
    S = A + transpose(A)
    tic()
    x = solve(A, b)
    rep("solve_{n}", toc())
    tic()
    Ai = inv(A)
    rep("inv_{n}", toc())
    tic()
    f = lu(A)
    rep("lu_{n}", toc())
    tic()
    f = qr(A)
    rep("qr_{n}", toc())
    if n <= 500
        tic()
        s = svd(A)
        rep("svd_{n}", toc())
        tic()
        e = eig(S)
        rep("eig_sym_{n}", toc())
        tic()
        e = eig(A)
        rep("eig_gen_{n}", toc())
    end if
end for

# ---- FFT ----
for n in (65536, 1048576, 1000, 4999, 10007, 100000, 1000003)
    x = randn(n)
    tic()
    X = fft(x)
    rep("fft_{n}", toc())
end for

x = randn(1000)
tic()
for k = 1 to 100
    X = fft(x)
end for
rep("fft_1000_x100", toc())
x = randn(4999)
tic()
for k = 1 to 100
    X = fft(x)
end for
rep("fft_4999_x100", toc())

# ---- filtering on 1e6 ----
x = randn(1000000)
lp = butter(4, "low", 100, 1000)
h = ones(64) / 64
tic()
y = filter_ba(h, [1], x)
rep("filter_fir64_1e6", toc())
tic()
y = filtfilt(lp, x)
rep("filtfilt_butter4_1e6", toc())
tic()
y = conv(x, h)
rep("conv_64tap_1e6", toc())

# ---- reductions on 1e7 ----
v = randn(10000000)
w = floor(rand(10000000) * 1000)
tic()
y = cumsum(v)
rep("cumsum_1e7", toc())
tic()
y = sort(v)
rep("sort_1e7", toc())
tic()
y = unique(w)
rep("unique_1e7", toc())
tic()
s = sum(v)
rep("sum_1e7", toc())
tic()
s = mean(v)
rep("mean_1e7", toc())
tic()
s = std(v)
rep("std_1e7", toc())

# ---- elementwise ----
a = randn(4000000)
b2 = randn(4000000)
tic()
c = sin(a) .* cos(b2) + exp(-a .* a) - sqrt(abs(b2))
rep("elementwise_chain_4e6", toc())
M = randn(2000, 2000)
r = randn(1, 2000)
cc = randn(2000, 1)
tic()
Z = M + r + cc
rep("broadcast_2000x2000", toc())

# ---- indexing / loops ----
M = randn(1000, 1000)
tic()
for i = 0 to 999
    for j = 0 to 999
        M[i, j] = i + j
    end for
end for
rep("matrix_assign_loop_1e6", toc())
tic()
s = 0.0
for i = 0 to 999
    s = s + sum(M[i, :])
end for
rep("row_slice_sum_1000", toc())
tic()
for i = 0 to 999
    M[:, i] = zeros(1000)
end for
rep("col_slice_assign_1000", toc())
tic()
s = scalar_loop(10000000)
rep("scalar_loop_1e7", toc())
tic()
s = ucall_loop(1000000)
rep("user_fn_call_1e6", toc())
tic()
s = 0.0
i = 0
while i < 3000000
    s = s + i
    i = i + 1
end while
rep("while_loop_3e6", toc())

# ---- strings ----
tic()
parts = ()
for i = 1 to 100000
    parts = append(parts, "item" + str(i))
end for
joined = join(parts, ",")
rep("str_build_join_1e5", toc())
tic()
sp = split(joined, ",")
rep("str_split_1e5", toc())
txt = ""
for i = 1 to 20000
    txt = txt + "id=" + str(i) + " value=" + str(i * 3) + "\n"
end for
tic()
n1 = regex_count(txt, "value=[0-9]+")
rep("regex_count_20k", toc())
tic()
t2 = regex_replace(txt, "id=([0-9]+)", "ID:$1")
rep("regex_replace_20k", toc())

# ---- CSV 1e6 rows ----
g = floor(rand(1000000) * 50)
df = table(group = g, value = randn(1000000), weight = rand(1000000))
p = tmp_file()
tic()
write_csv(df, p)
rep("csv_write_1e6", toc())
tic()
df2 = read_csv(p)
rep("csv_read_1e6", toc())

# ---- struct / dict / list in loops ----
tic()
d = dict()
for i = 0 to 4999
    d = set(d, "k{i}", i)
end for
s = 0
for i = 0 to 4999
    s = s + get(d, "k{i}")
end for
rep("dict_5e3_set_get", toc())
tic()
l = ()
for i = 0 to 99999
    l = append(l, i)
end for
s = 0
for i = 0 to 99999
    s = s + l[i]
end for
rep("list_1e5_append_get", toc())
rec = {a = 1, b = 2}
tic()
s = 0
for i = 1 to 1000000
    s = s + rec.b + rec.a
end for
rep("record_field_loop_1e6", toc())

# ---- 0.4.7 features ----
tic()
r = ode45("fsys", [0, 1000], [1, 0], rtol=1e-8, atol=1e-10)
rep("ode45_sho_t1000", toc())
tic()
q = 0.0
for k = 1 to 200
    q = q + quad("integrand", -10, 10, 1e-12)
end for
rep("quad_smooth_x200", toc())
y = randn(10000000)
tic()
t = trapz(y)
rep("trapz_1e7", toc())

pn = tmp_file() + ".npy"
big = randn(10000000)
tic()
write_npy(pn, big)
rep("npy_write_1e7", toc())
tic()
rb = read_npy(pn)
rep("npy_read_1e7", toc())
