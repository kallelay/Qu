# bench_impedance_fit.qu -- equivalent-circuit parameter recovery, an
# accuracy demo in Ahmed's own domain (impedance spectroscopy).
#
# NOT rLKK: rLKK (catalog/qu_impedance_rlkk.qu) is Ahmed's own regularized
# linear Kramers-Kronig CONSISTENCY check -- it validates a spectrum
# without assuming any circuit, and extracts no component values. This is
# a different, standard, textbook technique: fit a Randles equivalent
# circuit (Rs + Rct parallel Cdl -- the same synthetic model rLKK's own
# demo already uses as test data) to impedance data via nonlinear least
# squares, and check whether the fit recovers the EXACT values used to
# synthesize it. Public-safe by construction: a textbook circuit, no
# proprietary method involved.
#
# The ground truth is exact because the data is synthetic: Rs, Rct, Cdl
# are chosen, the spectrum is computed from the closed-form Randles
# formula, then the fit is asked to recover those same three numbers
# from nothing but the spectrum. Recovery error is a real number, not an
# argument.
#
# Same hand-rolled Nelder-Mead in all three languages, deliberately, not
# each language's own preferred optimizer: Qu's only general minimizer
# (`minimize`) is gradient-based (L-BFGS); this MATLAB install has no
# Optimization Toolbox, so `fminsearch` (Nelder-Mead) is the only
# generic minimizer available at all. Using three different algorithm
# classes would confound "which optimizer" with "which language" --
# using the identical algorithm, ported line-for-line, isolates language
# and floating-point behaviour instead. Verified on the Rosenbrock
# function (known minimum (1,1), f=0) before being trusted on anything
# real: recovered (1.00000034, 1.00000065), f=2.45e-13 in 119 iterations.

function list_set(lst, idx, val)
    n = length(lst)
    out = ()
    for i = 0 to n - 1
        if i == idx then
            out = append(out, val)
        else
            out = append(out, lst[i])
        end if
    end for
    return out
end function

function nelder_mead(f, x0, max_iter, tol)
    n = length(x0)
    alpha = 1.0
    gamma = 2.0
    rho = 0.5
    sigma = 0.5

    simplex = ()
    simplex = append(simplex, x0)
    for i = 0 to n - 1
        pi_ = x0
        delta = 0.05
        if pi_[i] != 0.0 then
            delta = 0.05 * abs(pi_[i])
        end if
        pi_[i] = pi_[i] + delta
        simplex = append(simplex, pi_)
    end for

    fvals = zeros(n + 1)
    for i = 0 to n
        fvals[i] = f(simplex[i])
    end for

    for it = 1 to max_iter
        order = argsort(fvals)
        new_simplex = ()
        new_fvals = zeros(n + 1)
        for i = 0 to n
            new_simplex = append(new_simplex, simplex[order[i]])
            new_fvals[i] = fvals[order[i]]
        end for
        simplex = new_simplex
        fvals = new_fvals

        if abs(fvals[n] - fvals[0]) < tol then
            return {x = simplex[0], f = fvals[0], iters = it}
        end if

        centroid = zeros(n)
        for i = 0 to n - 1
            centroid = centroid + simplex[i]
        end for
        centroid = centroid / n

        xr = centroid + alpha * (centroid - simplex[n])
        fr = f(xr)

        if fr < fvals[0] then
            xe = centroid + gamma * (centroid - simplex[n])
            fe = f(xe)
            if fe < fr then
                simplex = list_set(simplex, n, xe)
                fvals[n] = fe
            else
                simplex = list_set(simplex, n, xr)
                fvals[n] = fr
            end if
        elseif fr < fvals[n - 1] then
            simplex = list_set(simplex, n, xr)
            fvals[n] = fr
        else
            xc = centroid + rho * (simplex[n] - centroid)
            fc = f(xc)
            if fc < fvals[n] then
                simplex = list_set(simplex, n, xc)
                fvals[n] = fc
            else
                for i = 1 to n
                    shrunk = simplex[0] + sigma * (simplex[i] - simplex[0])
                    simplex = list_set(simplex, i, shrunk)
                    fvals[i] = f(shrunk)
                end for
            end if
        end if
    end for
    return {x = simplex[0], f = fvals[0], iters = max_iter}
end function

# ---- the Randles circuit: Rs + Rct parallel Cdl -----------------------
j = 0 + 1i
Rs_true = 0.2
Rct_true = 0.01
Cdl_true = 100e-6

randles(freqs, Rs, Rct, Cdl) := Rs + Rct ./ (1 + j .* (2 * pi * freqs) .* Rct .* Cdl)

# Cdl is ~1e-4 while Rs/Rct are ~1e-1 -- a badly scaled simplex converges
# slowly or not at all. Fit in a rescaled parameter p = [Rs, Rct, Cdl*1e6]
# so all three coordinates are O(0.01-100), converting back only inside
# the model. This is ordinary practice, not a shortcut -- worth stating
# because a demo that skips it would either fail to converge or would be
# quietly measuring the rescaling's effect rather than the optimizer's.
#
# `residual` reads the module-level `freqs`/`Z_true` directly rather
# than taking them as parameters: Qu functions close over module scope,
# not an enclosing FUNCTION's locals (reads fall through to module
# scope only -- confirmed the hard way, a first draft tried passing
# them through a nested `:=` closure and got `freqs is not defined`).
# `fit_randles` below reassigns the module-level `freqs`/`Z_true`
# before each call, matching how the rest of this file already uses
# module scope for the true circuit values.
function residual(p)
    Rs = p[0]
    Rct = p[1]
    Cdl = p[2] * 1e-6
    Z_model = randles(freqs, Rs, Rct, Cdl)
    diff = Z_model - Z_true
    return sum(abs(diff) ^ 2)
end function

function fit_randles(sweep_freqs, sweep_Z_true, p0)
    global freqs
    global Z_true
    freqs = sweep_freqs
    Z_true = sweep_Z_true
    tic()
    result = nelder_mead(residual, p0, 2000, 1e-16)
    t = toc()
    return {Rs = result.x[0], Rct = result.x[1], Cdl = result.x[2] * 1e-6,
            residual = result.f, iters = result.iters, time = t}
end function

function report(label, fit)
    rel_Rs = abs(fit.Rs - Rs_true) / Rs_true
    rel_Rct = abs(fit.Rct - Rct_true) / Rct_true
    rel_Cdl = abs(fit.Cdl - Cdl_true) / Cdl_true
    print("{label}")
    print("  recovered  : Rs={fit.Rs:.6f}  Rct={fit.Rct:.6f}  Cdl={fit.Cdl:e}")
    print("  rel. error : Rs={rel_Rs:e}  Rct={rel_Rct:e}  Cdl={rel_Cdl:e}")
    print("  residual={fit.residual:e}  iters={fit.iters}  time={fit.time:.6f} s")
end function

p0 = [0.15, 0.02, 50.0]   # perturbed from truth -- a genuine recovery test
print("true value : Rs={Rs_true:.6f}  Rct={Rct_true:.6f}  Cdl={Cdl_true:e}")
print("")

# THE LESSON, SHOWN NOT JUST ASSERTED: a model can fit its data almost
# perfectly and still fail to determine its own parameters. The RC
# "knee" (where Cdl's effect becomes visible) sits at
# 1/(2*pi*Rct*Cdl) = ~159 kHz for these true values -- a sweep that
# never reaches it can't constrain Rct and Cdl individually, no matter
# how good the optimizer or how careful the language is. This is the
# first draft's actual, real mistake, kept in rather than fixed away:
freqs_bad = logspace(0, 4, 40)          # 1 Hz - 10 kHz: never reaches the knee
Z_true_bad = randles(freqs_bad, Rs_true, Rct_true, Cdl_true)
fit_bad = fit_randles(freqs_bad, Z_true_bad, p0)
max_spectral_err_bad = max(abs(randles(freqs_bad, fit_bad.Rs, fit_bad.Rct, fit_bad.Cdl) - Z_true_bad))
report("sweep 1 Hz - 10 kHz (never reaches the ~159 kHz RC knee):", fit_bad)
print("  max |Z_fit - Z_true| across this sweep: {max_spectral_err_bad:e}  (data scale ~{max(abs(Z_true_bad)):.2f} -- the spectrum fit is EXCELLENT despite the parameters being wrong)")
print("")

freqs_good = logspace(1, 7, 40)         # 10 Hz - 10 MHz: spans 2 decades either side of the knee
Z_true_good = randles(freqs_good, Rs_true, Rct_true, Cdl_true)
fit_good = fit_randles(freqs_good, Z_true_good, p0)
max_spectral_err_good = max(abs(randles(freqs_good, fit_good.Rs, fit_good.Rct, fit_good.Cdl) - Z_true_good))
report("sweep 10 Hz - 10 MHz (spans the knee):", fit_good)
print("  max |Z_fit - Z_true| across this sweep: {max_spectral_err_good:e}")
print("")
print("SAME optimizer, SAME true circuit, SAME starting guess -- only the")
print("measured frequency RANGE differs. That range alone is the difference")
print("between Rct/Cdl recovered to ~1e-7 relative error and Rct off by")
print("~40% while the fit itself looks nearly perfect. A spectrum-fit")
print("residual is not evidence that a parameter is well determined --")
print("exactly the question Ahmed's requested significance-testing feature")
print("(permutation / Student's-t on fitted parameters) would answer directly.")
