# Multiple Qu implementations of the same computation, cross-checked.
#
# The suite reports ONE Qu number per kernel. That answers "how fast can Qu
# do this" but not "what does it cost a user who writes the obvious thing
# instead of the fast thing", which is the question a person choosing a
# language actually has. Every approach below must also AGREE: a difference
# in the ANSWER between two supposedly-equivalent approaches would be a
# correctness bug hiding inside a performance benchmark.
#
# Sizes are smaller than bench.qu where an approach is O(n^3) or interpreted
# per element, so the slow way finishes at all. Indexing is 0-based.

print("=== 1. SUM OF 1..N  (N = 1,000,000) ===")
n = 1000000

tic()
s1 = 0
for i = 1 to n
    s1 = s1 + i
end for
t1 = toc()
print("  [a] scalar for loop     : {t1:.4f} s   -> {s1}")

tic()
v = 1:n
s2 = sum(v)
t2 = toc()
print("  [b] range + sum()       : {t2:.4f} s   -> {s2}")

tic()
s3 = n * (n + 1) / 2
t3 = toc()
print("  [c] closed form         : {t3:.6f} s   -> {s3}")

print("  agree? |a-b| = {abs(s1 - s2):.1f}   |a-c| = {abs(s1 - s3):.1f}")

print("")
print("=== 2. ELEMENTWISE  y = a.*b + sin(a).*cos(b)  (N = 2,000,000) ===")
m = 2000000
a = randn(m, 1)
b = randn(m, 1)

tic()
y1 = a .* b + sin(a) .* cos(b)
e1 = toc()
print("  [a] vectorized          : {e1:.4f} s")

tic()
y2 = zeros(m, 1)
for i = 0 to m - 1
    y2[i] = a[i] * b[i] + sin(a[i]) * cos(b[i])
end for
e2 = toc()
print("  [b] scalar for loop     : {e2:.4f} s")

dab = max(abs(y1 - y2))
print("  agree? max|a-b| = {dab:.3e}")
print("  cost of writing the loop: {e2 / e1:.1f}x slower")

print("")
print("=== 3. MATRIX MULTIPLY  (300 x 300, so the manual way finishes) ===")
k = 300
A = randn(k, k)
B = randn(k, k)

tic()
C1 = A * B
q1 = toc()
print("  [a] built-in A * B      : {q1:.4f} s")

tic()
C2 = zeros(k, k)
for i = 0 to k - 1
    for j = 0 to k - 1
        acc = 0.0
        for p = 0 to k - 1
            acc = acc + A[i, p] * B[p, j]
        end for
        C2[i, j] = acc
    end for
end for
q2 = toc()
print("  [b] triple scalar loop  : {q2:.4f} s")

dq = max(max(abs(C1 - C2)))
print("  agree? max|a-b| = {dq:.3e}")
print("  cost of writing the loop: {q2 / q1:.0f}x slower")

print("")
print("=== 4. DOT PRODUCT  (N = 5,000,000) ===")
p = 5000000
u = randn(p, 1)
w = randn(p, 1)

tic()
d1 = sum(u .* w)
r1 = toc()
print("  [a] sum(u .* w)         : {r1:.4f} s   -> {d1:.6e}")

tic()
d3 = 0.0
for i = 0 to p - 1
    d3 = d3 + u[i] * w[i]
end for
r3 = toc()
print("  [c] scalar for loop     : {r3:.4f} s   -> {d3:.6e}")

print("  agree? |a-c| = {abs(d1 - d3):.3e}")
print("  cost of writing the loop: {r3 / r1:.1f}x slower")
