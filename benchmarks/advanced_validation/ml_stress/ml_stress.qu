# ml_stress.qu -- two real ML stress cases on the SAME 2000-sample,
# 12-feature, 4-class dataset (classification_{train,test}.csv, generated
# once by make_dataset.py, stratified 80/20 split, same rows ml_stress.py
# reads), well beyond catalog/qu_classification_report.qu's 120-point toy:
#
#   1. knn_model(k=7) -- deterministic (no random init anywhere), so this
#      is checked for an EXACT match against sklearn's KNeighborsClassifier
#      on the same split.
#   2. Sequential API MLP (12->32->16->4, ReLU, Adam, cross-entropy),
#      exercising the newer `sequential`/`dense_layer`/`.fit(optimizer=)`
#      surface at real scale -- ../../mlp/ already stress-tested the
#      OLDER manual param()/grad()/stop_grad() loop with bit-identical
#      init; this one uses Qu's own random init (seed=42) and PyTorch's own
#      random init separately (see ml_stress.py's own comment for why: no
#      bit-identical-init shortcut exists across two different RNGs without
#      the make_dataset.py-style precomputed-weights trick used in ../../mlp/,
#      and duplicating that machinery here would just re-test what ../../mlp/
#      already covers -- this test asks a different, still-valid question:
#      does Qu's own Adam-based Sequential .fit converge as well as
#      PyTorch's Adam on the same data/architecture/hyperparameters/epochs,
#      each from its own random start).
#
# Constructs exercised (all real, verified-working builtins):
#   read_csv, hstack/reshape (dataframe -> matrix, same convention as
#     ../../mlp/bench.qu and ../../shallow_ml/bench.qu)
#   knn_model(X, y, k, kind="classification"), .predict, .score
#   dense_layer(in, out, activation=), sequential(layers, seed=), adam(lr=)
#   net.fit(X, Y, epochs=, loss=, optimizer=), .predict, .loss_history
#   tic()/toc()
#
# Run: qu run benchmarks/advanced_validation/ml_stress/ml_stress.qu

backend auto

DATA = "benchmarks/advanced_validation/ml_stress/"
N_FEATURES = 12
N_CLASSES = 4

df = read_csv(DATA + "classification_train.csv")
dfte = read_csv(DATA + "classification_test.csv")
n = nrow(df)
nte = nrow(dfte)
Xtr = hstack(reshape(df.f0, n, 1), reshape(df.f1, n, 1), reshape(df.f2, n, 1), reshape(df.f3, n, 1), reshape(df.f4, n, 1), reshape(df.f5, n, 1), reshape(df.f6, n, 1), reshape(df.f7, n, 1), reshape(df.f8, n, 1), reshape(df.f9, n, 1), reshape(df.f10, n, 1), reshape(df.f11, n, 1))
Xte = hstack(reshape(dfte.f0, nte, 1), reshape(dfte.f1, nte, 1), reshape(dfte.f2, nte, 1), reshape(dfte.f3, nte, 1), reshape(dfte.f4, nte, 1), reshape(dfte.f5, nte, 1), reshape(dfte.f6, nte, 1), reshape(dfte.f7, nte, 1), reshape(dfte.f8, nte, 1), reshape(dfte.f9, nte, 1), reshape(dfte.f10, nte, 1), reshape(dfte.f11, nte, 1))
ytr = df.y
yte = dfte.y
print("train {n}x{cols(Xtr)}, test {nte}x{cols(Xte)}, classes={N_CLASSES}")
print("")

# =========================== Sub-case 1: k-NN (k=7) ==========================
# Purely deterministic (no RNG anywhere in knn_model) -- an exact-match
# check against sklearn on the same split.
tic()
knn = knn_model(Xtr, ytr, 7, kind="classification")
knn_fit_t = toc()
tic()
knn_pred = knn.predict(Xte)
knn_pred_t = toc()
knn_acc = knn.score(Xte, yte)
print("knn(k=7)      fit_time={knn_fit_t*1000:.4f} ms  pred_time={knn_pred_t*1000:.4f} ms")
print("knn(k=7)      test_accuracy={knn_acc:.4f}")
print("knn(k=7)      predictions (first 20) = {knn_pred[0:19]}")
# Dump every test-set prediction so ml_stress.py can diff it ELEMENTWISE
# against sklearn's own predictions, not just compare accuracy numbers
# (same accuracy doesn't prove identical predictions -- an elementwise diff
# does).
write_csv(table(qu_pred=knn_pred), DATA + "knn_qu_predictions.csv")
print("")

# =========================== Sub-case 2: Sequential MLP (Adam) ==============
# `.fit(..., loss="cross_entropy")` expects Y as ONE-HOT rows (the loss is
# built from `softmax_rows`/`ln`/`row_sum`, see `sequential_loss`'s own doc
# comment) and `.predict` returns raw logits, not class labels -- same
# one-hot-encode + per-row-argmax pattern ../../mlp/bench.qu uses.
function one_hot(y, rows, k)
    m = zeros(rows, k)
    for i = 0 to rows - 1
        m[i, y[i]] = 1
    end for
    return m
end function

function accuracy_from_logits(logits, y, rows)
    correct = 0
    for i = 0 to rows - 1
        if argmax(logits[i, :]) == y[i] then
            correct = correct + 1
        end if
    end for
    return correct / rows
end function

Ytr = one_hot(ytr, n, N_CLASSES)

layers = (
    dense_layer(N_FEATURES, 32, activation="relu"),
    dense_layer(32, 16, activation="relu"),
    dense_layer(16, N_CLASSES, activation="none"),
)
net = sequential(layers, seed=42)

EPOCHS = 150
tic()
trained = net.fit(Xtr, Ytr, epochs=EPOCHS, loss="cross_entropy", optimizer=adam(lr=0.001))
mlp_train_t = toc()

first_loss = trained.loss_history[0]
last_loss = trained.loss_history[length(trained.loss_history) - 1]

logits_tr = trained.predict(Xtr)
logits_te = trained.predict(Xte)
train_acc = accuracy_from_logits(logits_tr, ytr, n)
test_acc = accuracy_from_logits(logits_te, yte, nte)

print("sequential_mlp epochs={EPOCHS}  train_time={mlp_train_t:.4f} s  per_epoch={1000*mlp_train_t/EPOCHS:.4f} ms")
print("sequential_mlp first_loss={first_loss:.6f}  last_loss={last_loss:.6f}")
print("sequential_mlp train_accuracy={train_acc:.4f}  test_accuracy={test_acc:.4f}")
