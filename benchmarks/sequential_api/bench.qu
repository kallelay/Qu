# bench.qu -- Sequential-API ease-of-use + speed benchmark: Qu's
# `mlp_classifier(...)`/`sequential(...)` + `net.fit(...)` one-liner
# high-level API vs Keras' `Sequential([...])` + `model.compile()` +
# `model.fit()` (bench.py). This is a DIFFERENT comparison than
# `../mlp/bench.qu`, which benchmarks a MANUAL `param()`/`grad()`/
# `stop_grad()` training loop written by hand in both languages (found
# PyTorch ~7x faster there, real per-`call_builtin` interpreter-dispatch
# overhead re-running the tape from scratch every epoch, not matmul
# throughput). Here the training loop itself is a single native-Rust
# builtin call (`sequential_fit` in `engine/crates/qu-interp/src/lib.rs`)
# that runs entirely inside `net.fit(...)` -- no Qu `for`-loop bytecode
# ever executes per epoch -- so this asks: does moving the loop out of
# the interpreted script and into native Rust close any of that gap?
#
# Same architecture, same data as `../mlp/`: `20 -> 64 -> 32 -> 4`, ReLU
# hidden layers, softmax + cross-entropy output, full-batch gradient
# descent, 300 epochs, lr=0.05 -- reusing `../mlp/`'s already-committed
# `classification_{train,test}.csv` directly (same
# `make_classification(n_samples=3000, ..., random_state=42)` split) so
# this is a fair before/after against that benchmark's own numbers, not
# a different dataset in disguise. NOT byte-identical initial weights
# this time (`sequential(..., seed=42)` uses Qu's own He/Xavier
# initializer, not `../mlp/`'s numpy-literal-pasted weights) -- that
# bit-identical-floats rigor is `../mlp/README.md`'s own contribution;
# this benchmark is about the one-liner API surface and training-loop
# speed, not re-proving gradient correctness from scratch again.
#
# Run: qu run benchmarks/sequential_api/bench.qu
# (or: cargo run --manifest-path engine/Cargo.toml -p qu-cli --release -- run benchmarks/sequential_api/bench.qu)

backend auto

DATA = "benchmarks/mlp/"
EPOCHS = 300
LR = 0.05
N_CLASSES = 4

# --- load data (same CSVs ../mlp/bench.qu reads) ----------------------------
df = read_csv(DATA + "classification_train.csv")
dfte = read_csv(DATA + "classification_test.csv")
n = nrow(df)
nte = nrow(dfte)
Xtr = hstack(reshape(df.f0, n, 1), reshape(df.f1, n, 1), reshape(df.f2, n, 1), reshape(df.f3, n, 1), reshape(df.f4, n, 1), reshape(df.f5, n, 1), reshape(df.f6, n, 1), reshape(df.f7, n, 1), reshape(df.f8, n, 1), reshape(df.f9, n, 1), reshape(df.f10, n, 1), reshape(df.f11, n, 1), reshape(df.f12, n, 1), reshape(df.f13, n, 1), reshape(df.f14, n, 1), reshape(df.f15, n, 1), reshape(df.f16, n, 1), reshape(df.f17, n, 1), reshape(df.f18, n, 1), reshape(df.f19, n, 1))
Xte = hstack(reshape(dfte.f0, nte, 1), reshape(dfte.f1, nte, 1), reshape(dfte.f2, nte, 1), reshape(dfte.f3, nte, 1), reshape(dfte.f4, nte, 1), reshape(dfte.f5, nte, 1), reshape(dfte.f6, nte, 1), reshape(dfte.f7, nte, 1), reshape(dfte.f8, nte, 1), reshape(dfte.f9, nte, 1), reshape(dfte.f10, nte, 1), reshape(dfte.f11, nte, 1), reshape(dfte.f12, nte, 1), reshape(dfte.f13, nte, 1), reshape(dfte.f14, nte, 1), reshape(dfte.f15, nte, 1), reshape(dfte.f16, nte, 1), reshape(dfte.f17, nte, 1), reshape(dfte.f18, nte, 1), reshape(dfte.f19, nte, 1))
ytr = df.y
yte = dfte.y
print("train {n}x{cols(Xtr)}, test {nte}x{cols(Xte)}")

function one_hot(y, rows, k)
    m = zeros(rows, k)
    for i = 0 to rows - 1
        m[i, y[i]] = 1
    end for
    return m
end function

Ytr = one_hot(ytr, n, N_CLASSES)
Yte = one_hot(yte, nte, N_CLASSES)

# =============================================================================
# THE ENTIRE MODEL: construction through trained model -- 2 lines, no manual
# param()/dense()/relu()/grad()/stop_grad() anywhere. Compare against
# bench.py's model = keras.Sequential([...]); model.compile(...);
# model.fit(...) -- 3 statements, Keras needs an explicit compile() step Qu's
# `net.fit(..., loss=...)` folds into the fit call itself.
# =============================================================================
net = mlp_classifier(20, [64, 32], N_CLASSES, seed=42)

tic()
trained = net.fit(Xtr, Ytr, epochs=EPOCHS, lr=LR, loss="cross_entropy")
train_time = toc()
# =============================================================================

losses = trained.loss_history
print("first_loss={losses[0]:.6f}  last_loss={losses[EPOCHS - 1]:.6f}")
print("train_time_s={train_time:.4f}  per_epoch_ms={1000 * train_time / EPOCHS:.4f}")

# --- accuracy (train + test), via net.predict -- untracked, dropout-off -----
function accuracy(net, X, Y, rows)
    logits = net.predict(X)
    correct = 0
    for i = 0 to rows - 1
        row = logits[i, :]
        yrow = Y[i, :]
        if argmax(row) == argmax(yrow) then
            correct = correct + 1
        end if
    end for
    return correct / rows
end function

train_acc = accuracy(trained, Xtr, Ytr, n)
test_acc = accuracy(trained, Xte, Yte, nte)
print("train_accuracy={train_acc:.4f}  test_accuracy={test_acc:.4f}")
